+# The headings of the "What to export" list, one per orientation.
+ORIENTATION_LABELS = {BY_ROOM_OR_LAB: "By room or lab", BY_FACULTY: "By faculty"}
+
+CHOOSE_EXPORT_MESSAGE = (
